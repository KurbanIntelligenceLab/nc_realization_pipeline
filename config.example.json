{
  "_comment": "Fill every SET_ME before the step that needs it. Paths are relative to this file. Dates are YYYY-MM-DD.",
  "workdir": "work",
  "cutoff_date": "SET_ME (date of the COD export, YYYY-MM-DD)",

  "releases": [
    {
      "source": "OQMD 2015",
      "release_id": "oqmd_2015",
      "release_date": "2015-12-11",
      "path": "data/snapshots/oqmd_2015.csv",
      "granularity": "composition",
      "tau_ev_per_atom": "SET_ME (the source's stability criterion, eV/atom)",
      "side_from": "displayed",
      "columns": {},
      "expected_counts": {"stable_hypothetical": 3231, "stable_hypothetical_heusler_prototype": 2290}
    },
    {
      "source": "Materials Project",
      "release_id": "mp_SET_ME",
      "release_date": "SET_ME",
      "path": "data/snapshots/mp_SET_ME.csv",
      "granularity": "structure",
      "tau_ev_per_atom": "SET_ME",
      "side_from": "displayed",
      "columns": {}
    }
  ],

  "experiments": {"path": "data/experiments/experimental_reports.csv"},

  "retrieval": {
    "backend": "openalex",
    "openalex_email": "SET_ME (your e-mail, used by OpenAlex to contact heavy users)",
    "local_corpus": "data/corpus/corpus.jsonl",
    "k": 20
  },

  "llm": {
    "model": "SET_ME (e.g. claude-sonnet-5-5; record the exact string at registration)",
    "max_tokens": 1024,
    "temperature": null
  },

  "identity_tolerances": {"ltol": 0.2, "stol": 0.3, "angle_tol": 5.0, "comp_delta": 0.02},
  "horizons_years": [3, 5, 10],
  "ml_sources": ["GNoME", "Alexandria"],
  "ml_horizons_years": [2],
  "two_phase": {"GNoME": 5000},

  "sampling": {
    "n_per_cohort": 400,
    "min_per_stratum": 30,
    "assumed_error_rates": {"report": 0.2, "none": 0.05, "abstain": 0.3}
  },

  "threshold": {
    "sources": ["OQMD 2015", "Materials Project"],
    "figure_source": "OQMD 2015",
    "windows_mev": [10, 25, 50],
    "horizon_years": 5,
    "assumed_outcome_rate": "SET_ME (pilot realization rate near the threshold, e.g. 0.05)",
    "effect_of_interest": "SET_ME (pre-registered effect, as a share, e.g. 0.03)"
  },

  "premise": {
    "pairs": [{"a": "oqmd_2015", "b": "mp_SET_ME", "match": "composition"}],
    "edges_mev": [0, 10, 25, 50, 100, 200, 1000000000]
  },

  "relabeling": [
    {
      "name": "mp_r_to_r1",
      "release_r": "SET_ME",
      "release_r1": "SET_ME",
      "raw_entries_r1": "data/relabel/raw_entries_r1.json",
      "scheme_r": "MaterialsProjectCompatibility",
      "scheme_r1": "MaterialsProject2020Compatibility",
      "corrected_species": ["SET_ME (species whose correction changed between the schemes)"]
    }
  ],
  "relabel_min_F": 30,

  "control_panel": {"path": "data/control_panel.csv"},

  "seeds": {"expert_sample": 20261211, "two_phase": 11, "residual_audit": 12, "rerun": 13}
}
